# =============================================================================
# .gitignore — keep only script files; exclude data, models, artifacts
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Training artifacts
runs/
*.zip
*.npz
best_model*
warehouse_layout_ppo*

# Saved experiment results (uncurated)
results/
"Layout Results"/

# Generated CSVs (simulation outputs)
*.csv

# Generated JSON state files
kpi_bounds.json
sensitivity_baseline.json

# Generated figures (regenerate from scripts)
*.png
*.pdf
*.svg

# Log files
*.log
nohup.out

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Windows / WSL artifacts
*:Zone.Identifier

# =============================================================================
# EXCEPTIONS — must come AFTER the rules they override
# =============================================================================
# Final_Training_Results/ is the curated final experiment bundle. Re-include
# everything inside it despite the global excludes above (*.zip, *.csv, *.png,
# *.pdf, *.npz). The `**` glob covers files at any depth.
!Final_Training_Results/
!Final_Training_Results/**
